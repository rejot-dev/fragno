{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fragno-workflows-heap-benchmark",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKFLOW_BENCHMARK",
        "class_name": "WorkflowBenchmarkObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorkflowBenchmarkObject"],
    },
  ],
}
