{
  "name": "@fragno-private/backoffice-conversation",
  "version": "0.0.0",
  "private": true,
  "description": "A Backoffice agent's conversation without its components: the formats Backoffice writes into it, its projection into chat messages, and its live view from the agent's view socket.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "packages-private/backoffice-conversation"
  },
  "type": "module",
  "exports": {
    "./live/view-socket": "./src/live/view-socket.ts",
    "./projection/assistant-runtime": "./src/projection/assistant-runtime.ts",
    "./projection/earlier-history": "./src/projection/earlier-history.ts",
    "./projection/pending-messages": "./src/projection/pending-messages.ts"
  },
  "scripts": {
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.1",
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@fragno-dev/backoffice-api": "workspace:*"
  },
  "devDependencies": {
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "happy-dom": "^20.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
