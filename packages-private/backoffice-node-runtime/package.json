{
  "name": "@fragno-private/backoffice-node-runtime",
  "private": true,
  "type": "module",
  "exports": {
    "./local-durable-objects": {
      "types": "./dist/local-durable-objects.d.ts",
      "default": "./dist/local-durable-objects.js"
    },
    "./node-alarm-scheduler": {
      "types": "./dist/node-alarm-scheduler.d.ts",
      "default": "./dist/node-alarm-scheduler.js"
    },
    "./node-durable-hooks": {
      "types": "./dist/node-durable-hooks.d.ts",
      "default": "./dist/node-durable-hooks.js"
    },
    "./sqlite-connection-config": {
      "types": "./dist/sqlite-connection-config.d.ts",
      "default": "./dist/sqlite-connection-config.js"
    },
    "./sqlite-durable-object-state": {
      "types": "./dist/sqlite-durable-object-state.d.ts",
      "default": "./dist/sqlite-durable-object-state.js"
    },
    "./sqlite-object-coordination": {
      "types": "./dist/sqlite-object-coordination.d.ts",
      "default": "./dist/sqlite-object-coordination.js"
    },
    "./sqlite-object-storage": {
      "types": "./dist/sqlite-object-storage.d.ts",
      "default": "./dist/sqlite-object-storage.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@fragno-dev/db": "workspace:*",
    "better-sqlite3": "12.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.9",
    "tsdown": "^0.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  }
}
