{
  "name": "@fragno-private/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Backoffice design system: theme tokens, component styles, and shared React components.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "packages-private/design-system"
  },
  "type": "module",
  "exports": {
    "./theme.css": "./src/theme.css",
    "./components.css": "./src/components.css",
    "./cn": "./src/cn.ts",
    "./brand-font": "./src/brand-font.ts",
    "./forms/*": "./src/components/forms/*.tsx",
    "./*": "./src/components/*.tsx"
  },
  "scripts": {
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev --port 6006 --no-open",
    "storybook:build": "storybook build --output-dir build/storybook",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@jsonforms/core": "^3.7.0",
    "@jsonforms/react": "^3.7.0",
    "clsx": "^2.1.1",
    "feather-icons": "^4.29.2",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/feather-icons": "^4.29.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "^8.18.0",
    "happy-dom": "^20.3.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.2.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  }
}
