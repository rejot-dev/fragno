{
  "name": "@fragno-private/pi-cloudflare-mcp-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown index.ts --format esm --out-dir dist --no-dts",
    "types:check": "tsc --noEmit",
    "test": "vitest run index.test.ts",
    "format:package": "node ../../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../../scripts/run-package-quality.mjs lint:fix"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-mcp": "1.0.2",
    "@fragno-private/typescript-config": "workspace:*",
    "@types/node": "^22.19.7",
    "tsdown": "^0.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
