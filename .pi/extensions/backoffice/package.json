{
  "name": "@fragno-private/pi-backoffice-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "types:check": "tsc --noEmit",
    "format:package": "node ../../../scripts/run-package-quality.mjs format",
