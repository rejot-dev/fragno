{
  "extends": "@fragno-private/typescript-config/tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles the app; nothing consumes its declarations.
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
