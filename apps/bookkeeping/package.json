    "@fragno-dev/ledger": "workspace:*",
    "@fragno-private/design-system": "workspace:*",
    "better-auth": "1.7.1",
    "isbot": "^5.1.32",
    "kysely": "^0.28.17",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.2.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@fragno-private/vitest-config": "workspace:*",
    "@react-router/dev": "^8.2.0",
    "@rejot-dev/backoffice-local": "workspace:*",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "better-sqlite3": "^12.10.0",
    "jose": "^6.2.3",
    "tailwindcss": "^4.2.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
