{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fragno-bookkeeping",
  "main": "workers/worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH", "class_name": "Auth" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "BOOKS", "class_name": "Books" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Auth"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspaces", "Workflows"] },
    { "tag": "v3", "new_sqlite_classes": ["Books"] },
    // Firms and their clients replace self-serve workspaces and the sign-up wizard that made them.
    {
      "tag": "v4",
      "new_sqlite_classes": ["Directory"],
      "deleted_classes": ["Workspaces", "Workflows"],
    },
  ],
  "observability": { "enabled": true },
}
