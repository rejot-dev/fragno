{
  "name": "@fragno-apps/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Leyway's Cloudflare infrastructure as code, managed with Pulumi",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "apps/infra"
  },
  "type": "module",
  "scripts": {
    "preview": "node --env-file-if-exists=.env scripts/pulumi.ts preview --stack prod",
    "apply": "node --env-file-if-exists=.env scripts/pulumi.ts up --stack prod",
    "pulumi": "node --env-file-if-exists=.env scripts/pulumi.ts",
    "types:check": "tsc --noEmit",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@pulumi/cloudflare": "6.23.3",
    "@pulumi/pulumi": "3.273.0",
    "@pulumi/random": "4.21.6"
  },
  "devDependencies": {
    "@fragno-private/typescript-config": "workspace:*",
    "@types/node": "^24.10.9",
    "typescript": "catalog:"
  },
  "engines": {
    "node": "^22.22.0 || >=24.11.0"
  }
}
