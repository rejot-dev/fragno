{
  "name": "@fragno-private/backoffice-context-cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "bin": {
    "backoffice-context": "./bin/run.js"
  },
  "type": "module",
  "main": "./dist/cli.js",
  "module": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "backoffice-context": "tsx ./src/cli.ts",
    "build": "tsdown",
    "types:check": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "oxfmt": "^0.40.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@types/node": "^22.19.7",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
