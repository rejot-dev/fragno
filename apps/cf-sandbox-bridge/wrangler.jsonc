{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-sandbox-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough",
  ],
  "observability": {
    "enabled": true,
    // Enable distributed tracing so the bridge's custom spans
    // (bridge.<operation>) are recorded alongside automatic instrumentation.
    // Each span is annotated with the sandbox ID, container UUID, and
    // operation-specific metadata (command, file path, port, session, etc.).
    "traces": {
      "enabled": true,
      // Fraction of requests to trace (0.0–1.0). 1.0 traces everything; lower
      // it to reduce overhead and cost under high traffic.
      "head_sampling_rate": 1,
    },
  },
  // Each Sandbox Durable Object starts its own container and chooses the image and instance type
  // at start time. The durable_object scheduling policy is immutable and cannot be rolled back to
  // the Sandbox SDK 0.x application this replaced, so the application has a new name.
  "containers": [
    {
      "class_name": "Sandbox",
      "name": "cf-sandbox-bridge-sandbox-v2",
      "scheduling_policy": "durable_object",
      "images": {
        "workspace": { "dockerfile": "./Dockerfile" },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Sandbox"],
      "tag": "v1",
    },
    {
      "new_sqlite_classes": ["WarmPool"],
      "tag": "v2",
    },
    {
      // Sandbox SDK 0.x kept a pool of pre-started containers; Durable Object scheduling starts
      // containers fast enough on demand.
      "deleted_classes": ["WarmPool"],
      "tag": "v3",
    },
  ],
  // Secrets — set via `wrangler secret put SANDBOX_API_KEY` before deploying.
  // Clients must send this value as: Authorization: Bearer <token>
  // Declared in .dev.vars.example so wrangler generates the Env type.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Sandbox containers reach Backoffice file links through this binding; see SandboxBackofficeEgress.
  "services": [{ "binding": "BACKOFFICE", "service": "rejot-backoffice-web" }],
  "preview_urls": false,
}
