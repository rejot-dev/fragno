{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["$TURBO_EXTENDS$", "static:generate"]
    },
    "build:node": {
      "dependsOn": ["$TURBO_EXTENDS$", "static:generate"]
    },
    "static:generate": {
      "dependsOn": ["^build"],
      "outputs": [
        "content/static/terminal/terminal-spec.json",
        "content/static/codemode/system.d.ts",
        "content/static/codemode/providers/**",
        "content/static/codemode/sources/mcp.d.ts",
        "content/static/skills/generating-backoffice-uis/CATALOG.md"
      ]
    },
    "types:generate": {
      "outputs": ["worker-configuration.d.ts", ".react-router/types/**", ".source/**"]
    },
    "types:check": {
      "dependsOn": ["^build", "types:generate"]
    },
    "lint:package": {
      "dependsOn": ["$TURBO_EXTENDS$", "types:generate"]
    },
    "lint:fix:package": {
      "dependsOn": ["$TURBO_EXTENDS$", "types:generate"]
    }
  }
}
