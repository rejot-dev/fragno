{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [
        "build/**",
        "dist/rejot_backoffice/**",
        "dist/cf_sandbox_bridge/**",
        ".react-router/**",
        "!build/**/.dev.vars",
        "!dist/**/.dev.vars"
      ],
      "env": ["VITE_POSTHOG_PROJECT_TOKEN", "VITE_POSTHOG_HOST", "VITE_POSTHOG_APP_ORIGIN"]
    },
    "preview": {
      "dependsOn": ["build"],
      "persistent": true,
      "cache": false
    },
    "static:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["node_modules/.vite/vitest/*/dependencies.json"]
    },
    "test:changed": {
      "dependsOn": ["^build"]
    },
    "test:cloudflare": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:bridge": {
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "dependsOn": ["^build"],
      "interruptible": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "types:generate": {
      "dependsOn": ["@rejot-dev/backoffice-local#build"],
      "outputs": ["worker-configuration.d.ts", ".react-router/types/**", ".source/**"]
    },
    "types:check": {
      "dependsOn": ["^build", "types:generate"]
    },
    "lint:package": {
      "dependsOn": ["$TURBO_EXTENDS$", "types:generate"]
    },
    "lint:fix:package": {
      "dependsOn": ["$TURBO_EXTENDS$", "types:generate"]
    }
  }
}
