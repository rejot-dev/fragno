{
  "include": [
    ".react-router/types/**/*",

    "backoffice-worker-topology.ts",
    "app/**/*",
    "app/**/.server/**/*",
    "app/**/.client/**/*",
    "workers/**/*",
    "worker-configuration.d.ts",
    "secrets.d.ts"
  ],
  "exclude": ["workers/react-router-worker-routing.test.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": [
      "vite/client",
      "@cloudflare/vitest-pool-workers",
      "@cloudflare/vitest-pool-workers/types"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./app/*"],
      "workers/*": ["./workers/*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "checkJs": true
  }
}
