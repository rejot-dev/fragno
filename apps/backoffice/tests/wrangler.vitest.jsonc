{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "fragno-back-office-vitest",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough",
  ],
  "main": "../workers/vitest-env.ts",
  "vars": {
    "AUTH_ACCESS_TOKEN_SECRET": "backoffice-vitest-auth-secret-at-least-32-characters",
    "BACKOFFICE_INTERNAL_REQUEST_SECRET": "backoffice-vitest-internal-request-secret-at-least-32-characters",
    "AUTH_EMAIL_VERIFICATION_ENABLED": "false",
    "SIGN_UP_INVITATIONS_ENABLED": "true",
    "DOCS_PUBLIC_BASE_URL": "https://backoffice.example/",
  },
  "services": [
    {
      "binding": "PI_EXTENSION_COMPILER",
      "service": "fragno-back-office-vitest",
      "entrypoint": "PiWorkspaceExtensionCompiler",
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTBOX_HARNESS",
        "class_name": "OutboxHarnessDurableObject",
      },
      {
        "name": "WORKFLOWS_HARNESS",
        "class_name": "WorkflowsHarnessDurableObject",
      },
      {
        "name": "AUTH_SQL_HARNESS",
        "class_name": "AuthSqlHarnessDurableObject",
      },
      { "name": "AUTH", "class_name": "Auth" },
      { "name": "AUTOMATIONS", "class_name": "Automations" },
      { "name": "MCP", "class_name": "Mcp" },
      { "name": "UPLOAD", "class_name": "Upload" },
      {
        "name": "PI",
        "class_name": "PiScenarioAgent",
      },
      {
        "name": "PI_MANAGER",
        "class_name": "PiScenarioManager",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OutboxHarnessDurableObject", "WorkflowsHarnessDurableObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AuthSqlHarnessDurableObject"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["PiScenarioAgent", "PiScenarioManager"],
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["Auth", "Automations", "Mcp", "Upload"],
    },
  ],
}
