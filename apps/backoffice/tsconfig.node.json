{
  "include": [
    "vite.config.ts",
    "vite.node.config.ts",
    "vite.node-server.config.ts",
    "react-router.config.ts",
    "source.config.ts",
    "vitest*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "scripts/better-auth-cli.ts",
    "scripts/node-server/node-process-config.ts",
    "scripts/node-server/node-server-listeners.ts",
    "scripts/node-server/node-server-proxy.scenario.test.ts",
    "scripts/node-server/node-supervisor-disconnect.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  }
}
