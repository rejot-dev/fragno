{
  "include": [
    "backoffice-worker-topology.ts",
    "vite.config.ts",
    "source.config.ts",
    "vitest*.ts",
    "scripts/**/*.ts",
    "workers/react-router-worker-routing.ts",
    "workers/react-router-worker-routing.test.ts"
  ],
  "exclude": ["scripts/better-auth-cli.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "checkJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  }
}
