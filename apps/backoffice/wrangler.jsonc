/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rejot-backoffice",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough",
    // Pi keeps cache-eviction timers only where `unref()` exists; nodejs_compat's global timers
    // expose a no-op `unref()`, so those timers would keep Pi's Durable Object from being evicted.
    "no_nodejs_global_timers",
    // Compiles each module on first import instead of at startup, so a cold isolate only pays for
    // the object implementations it wakes.
    "new_module_registry",
  ],
  "main": "./workers/objects.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  // The Rivet host reaches the Durable Object migrator here after DNS points at it.
  "workers_dev": true,
  "preview_urls": false,
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  // With `secrets` set, Cloudflare dev and preview load a .dev.vars key only when it is declared here
  // or in `secrets.required`. Settings belong in `vars`, so .dev.vars can override their defaults.
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAACEAKTUMl498hZ6v",
    "AUTH_EMAIL_VERIFICATION_ENABLED": "true",
    "SIGN_UP_ACCESS_CODES_REQUIRED": "true",
    // Keeps each organization's and user's Durable Objects in the jurisdiction they chose. Only
    // local .dev.vars says "local", as workerd does not implement jurisdictions.
    "DURABLE_OBJECT_JURISDICTIONS": "enforced",
    "LOCAL_EMAIL_LOG": "false",
    // Local servers started without the bridge's containers say "false", so sandbox starts fail at once.
    "SANDBOX_CONTAINERS": "true",
    "DOCS_PUBLIC_BASE_URL": "https://backoffice.rejot.dev/",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "OOMOL_CONNECTOR_BASE_URL": "https://connector.oomol.com/v1",
    // Empty uses the GitHub App fragment's defaults.
    "GITHUB_APP_API_BASE_URL": "",
    "GITHUB_APP_API_VERSION": "",
    "GITHUB_APP_WEB_BASE_URL": "",
    "GITHUB_APP_DEFAULT_LINK_KEY": "",
    "GITHUB_APP_TOKEN_CACHE_TTL_SECONDS": "",
    "GITHUB_APP_WEBHOOK_DEBUG": "",
    // The bucket of BLOBS_BUCKET below.
    "BLOBS_R2_BUCKET": "rejot-backoffice-blobs",
  },
  "secrets": {
    "required": [
      "AUTH_ACCESS_TOKEN_SECRET",
      "BACKOFFICE_INTERNAL_REQUEST_SECRET",
      "AUTH_ADMIN_GRANT_TOKEN",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GITHUB_APP_ID",
      "GITHUB_APP_SLUG",
      "GITHUB_APP_CLIENT_ID",
      "GITHUB_APP_CLIENT_SECRET",
      "GITHUB_APP_WEBHOOK_SECRET",
      "GITHUB_APP_PRIVATE_KEY",
      "OPENAI_API_KEY",
      "OOMOL_PROJECT_API_KEY",
      "OOMOL_CONNECTOR_CATALOG_API_KEY",
      "CLOUDFLARE_WORKERS_ACCOUNT_ID",
      "CLOUDFLARE_WORKERS_API_TOKEN",
      "RESON8_API_KEY",
      // Blobs reach their bucket through R2's S3 API, so they can hand out presigned URLs.
      "BLOBS_R2_ENDPOINT",
      "BLOBS_R2_ACCESS_KEY_ID",
      "BLOBS_R2_SECRET_ACCESS_KEY",
    ],
  },
  // Blobs use the S3 API, never this binding; it declares the bucket. Locally, the credentials make
  // Miniflare serve the bucket's S3 API under /cdn-cgi/local/r2/s3, which .dev.vars points blobs at.
  "r2_buckets": [
    {
      "binding": "BLOBS_BUCKET",
      "bucket_name": "rejot-backoffice-blobs",
      "local_dev": {
        "experimental_s3_credentials": {
          "accessKeyId": "local-blobs",
          "secretAccessKey": "local-blobs",
        },
      },
    },
  ],
  // Runs Workers AI models, such as Clairic, for the `backoffice#workers-ai` integration. Workers AI
  // has no local simulator, so local dev calls, and bills, the account Wrangler is logged in to.
  "ai": { "binding": "AI", "remote": true },
  // Tags telemetry with the deployed version, so errors and metrics can be compared per release.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Codemode guests compile and run in the bridge, one request each. Backoffice loads only the
  // checker of page queries, one per Automations object, as the class of a facet.
  "worker_loaders": [{ "binding": "LOADER" }],
  "services": [
    {
      "binding": "CODEMODE_COMPILER",
      "service": "cf-sandbox-bridge",
      "entrypoint": "CodemodeCompiler",
    },
    {
      "binding": "CODEMODE_EXECUTOR",
      "service": "cf-sandbox-bridge",
      "entrypoint": "CodemodeExecutor",
    },
  ],
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" }
  /**
   * Durable Objects
   * https://developers.cloudflare.com/durable-objects/
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "Api",
      },
      {
        "name": "AUTH",
        "class_name": "Auth",
      },
      {
        "name": "APPS",
        "class_name": "Apps",
      },
      {
        "name": "APP_INSTALLATIONS",
        "class_name": "AppInstallations",
      },
      {
        "name": "TELEGRAM",
        "class_name": "Telegram",
      },
      {
        "name": "RESEND",
        "class_name": "Resend",
      },
      {
        "name": "MCP",
        "class_name": "Mcp",
      },
      {
        "name": "PROJECT_CONNECTOR",
        "class_name": "ProjectConnectorDurableObject",
      },
      {
        "name": "OTP",
        "class_name": "Otp",
      },
      {
        "name": "UPLOAD",
        "class_name": "Upload",
      },
      {
        "name": "BLOBS",
        "class_name": "Blobs",
      },
      // Sandbox containers belong to the bridge, which deploys their application and image.
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
        "script_name": "cf-sandbox-bridge",
      },
      {
        "name": "SANDBOX_MANAGER",
        "class_name": "SandboxManager",
      },
      {
        "name": "GITHUB",
        "class_name": "GitHub",
      },
      {
        "name": "GITHUB_WEBHOOK_ROUTER",
        "class_name": "GitHubWebhookRouter",
      },
      {
        "name": "AUTOMATIONS",
        "class_name": "Automations",
      },
      {
        "name": "PI",
        "class_name": "Pi",
      },
      {
        "name": "PI_MANAGER",
        "class_name": "PiManager",
      },
      {
        "name": "BILLING",
        "class_name": "Billing",
      },
      {
        "name": "CODEMODE",
        "class_name": "Codemode",
      },
      {
        "name": "MARKETPLACE",
        "class_name": "Marketplace",
      },
      {
        "name": "CLOUDFLARE",
        "class_name": "Cloudflare",
      },
      {
        "name": "FORMS",
        "class_name": "Forms",
      },
      {
        "name": "PRESENCE",
        "class_name": "Presence",
      },
    ],
  },
  /**
   * Durable Object class lifecycle declarations
   * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
   */
  "exports": {
    "Api": { "type": "durable-object", "storage": "sqlite" },
    "Auth": { "type": "durable-object", "storage": "sqlite" },
    "Apps": { "type": "durable-object", "storage": "sqlite" },
    "AppInstallations": { "type": "durable-object", "storage": "sqlite" },
    "Telegram": { "type": "durable-object", "storage": "sqlite" },
    "Resend": { "type": "durable-object", "storage": "sqlite" },
    // Reson8 runs statelessly under the platform key; its per-organization keys are gone.
    "Reson8": { "type": "durable-object", "state": "deleted" },
    "Mcp": { "type": "durable-object", "storage": "sqlite" },
    "ProjectConnectorDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "Otp": { "type": "durable-object", "storage": "sqlite" },
    "Upload": { "type": "durable-object", "storage": "sqlite" },
    "Blobs": { "type": "durable-object", "storage": "sqlite" },
    // SANDBOX binds the bridge's Sandbox; this Worker's own copy and its namespace are gone.
    "Sandbox": { "type": "durable-object", "state": "deleted" },
    "SandboxManager": { "type": "durable-object", "storage": "sqlite" },
    "GitHub": { "type": "durable-object", "storage": "sqlite" },
    "GitHubWebhookRouter": { "type": "durable-object", "storage": "sqlite" },
    "Automations": { "type": "durable-object", "storage": "sqlite" },
    "Pi": { "type": "durable-object", "storage": "sqlite" },
    "PiManager": { "type": "durable-object", "storage": "sqlite" },
    "Billing": { "type": "durable-object", "storage": "sqlite" },
    "Codemode": { "type": "durable-object", "storage": "sqlite" },
    "Marketplace": { "type": "durable-object", "storage": "sqlite" },
    "Cloudflare": { "type": "durable-object", "storage": "sqlite" },
    "Forms": { "type": "durable-object", "storage": "sqlite" },
    "Presence": { "type": "durable-object", "storage": "sqlite" },
  },
}
