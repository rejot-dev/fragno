/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rejot-backoffice",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough",
  ],
  "main": "./workers/objects.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "workers_dev": false,
  "preview_urls": false,
  "dev": {
    "enable_containers": false,
  },
  // Each Sandbox Durable Object starts its own container and chooses the image and instance type
  // at start time. The durable_object scheduling policy is immutable and cannot be rolled back to
  // the Sandbox SDK 0.x application this replaced, so the application has a new name.
  "containers": [
    {
      "class_name": "Sandbox",
      "name": "rejot-backoffice-sandbox-v2",
      "scheduling_policy": "durable_object",
      "images": {
        "workspace": { "dockerfile": "../cf-sandbox-bridge/Dockerfile" },
      },
    },
  ],
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAACEAKTUMl498hZ6v",
    "AUTH_EMAIL_VERIFICATION_ENABLED": "true",
    "SIGN_UP_INVITATIONS_ENABLED": "true",
    "DOCS_PUBLIC_BASE_URL": "https://backoffice.rejot.dev/",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "OOMOL_CONNECTOR_BASE_URL": "https://connector.oomol.com/v1",
  },
  "secrets": {
    "required": [
      "AUTH_ACCESS_TOKEN_SECRET",
      "BACKOFFICE_INTERNAL_REQUEST_SECRET",
      "AUTH_ADMIN_GRANT_TOKEN",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GITHUB_APP_ID",
      "GITHUB_APP_SLUG",
      "GITHUB_APP_CLIENT_ID",
      "GITHUB_APP_CLIENT_SECRET",
      "GITHUB_APP_WEBHOOK_SECRET",
      "GITHUB_APP_PRIVATE_KEY",
      "OPENAI_API_KEY",
      "OOMOL_PROJECT_API_KEY",
      "OOMOL_CONNECTOR_CATALOG_API_KEY",
      "CLOUDFLARE_WORKERS_ACCOUNT_ID",
      "CLOUDFLARE_WORKERS_API_TOKEN",
    ],
  },
  "r2_buckets": [
    {
      "binding": "UPLOAD_BUCKET",
      "bucket_name": "rejot-backoffice-upload",
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "services": [
    {
      "binding": "CODEMODE_COMPILER",
      "service": "cf-sandbox-bridge",
      "entrypoint": "CodemodeCompiler",
    },
  ],
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" }
  /**
   * Durable Objects
   * https://developers.cloudflare.com/durable-objects/
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "Api",
      },
      {
        "name": "AUTH",
        "class_name": "Auth",
      },
      {
        "name": "APPS",
        "class_name": "Apps",
      },
      {
        "name": "APP_INSTALLATIONS",
        "class_name": "AppInstallations",
      },
      {
        "name": "TELEGRAM",
        "class_name": "Telegram",
      },
      {
        "name": "RESEND",
        "class_name": "Resend",
      },
      {
        "name": "RESON8",
        "class_name": "Reson8",
      },
      {
        "name": "MCP",
        "class_name": "Mcp",
      },
      {
        "name": "PROJECT_CONNECTOR",
        "class_name": "ProjectConnectorDurableObject",
      },
      {
        "name": "OTP",
        "class_name": "Otp",
      },
      {
        "name": "UPLOAD",
        "class_name": "Upload",
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
      },
      {
        "name": "SANDBOX_MANAGER",
        "class_name": "SandboxManager",
      },
      {
        "name": "GITHUB",
        "class_name": "GitHub",
      },
      {
        "name": "GITHUB_WEBHOOK_ROUTER",
        "class_name": "GitHubWebhookRouter",
      },
      {
        "name": "AUTOMATIONS",
        "class_name": "Automations",
      },
      {
        "name": "PI",
        "class_name": "Pi",
      },
      {
        "name": "PI_MANAGER",
        "class_name": "PiManager",
      },
      {
        "name": "BILLING",
        "class_name": "Billing",
      },
      {
        "name": "CODEMODE",
        "class_name": "Codemode",
      },
      {
        "name": "MARKETPLACE",
        "class_name": "Marketplace",
      },
      {
        "name": "CLOUDFLARE",
        "class_name": "Cloudflare",
      },
      {
        "name": "FORMS",
        "class_name": "Forms",
      },
    ],
  },
  /**
   * Durable Object class lifecycle declarations
   * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
   */
  "exports": {
    "Api": { "type": "durable-object", "storage": "sqlite" },
    "Auth": { "type": "durable-object", "storage": "sqlite" },
    "Apps": { "type": "durable-object", "storage": "sqlite" },
    "AppInstallations": { "type": "durable-object", "storage": "sqlite" },
    "Telegram": { "type": "durable-object", "storage": "sqlite" },
    "Resend": { "type": "durable-object", "storage": "sqlite" },
    "Reson8": { "type": "durable-object", "storage": "sqlite" },
    "Mcp": { "type": "durable-object", "storage": "sqlite" },
    "ProjectConnectorDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "Otp": { "type": "durable-object", "storage": "sqlite" },
    "Upload": { "type": "durable-object", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "storage": "sqlite" },
    "SandboxManager": { "type": "durable-object", "storage": "sqlite" },
    "GitHub": { "type": "durable-object", "storage": "sqlite" },
    "GitHubWebhookRouter": { "type": "durable-object", "storage": "sqlite" },
    "Automations": { "type": "durable-object", "storage": "sqlite" },
    "Pi": { "type": "durable-object", "storage": "sqlite" },
    "PiManager": { "type": "durable-object", "storage": "sqlite" },
    "Billing": { "type": "durable-object", "storage": "sqlite" },
    "Codemode": { "type": "durable-object", "storage": "sqlite" },
    "Marketplace": { "type": "durable-object", "storage": "sqlite" },
    "Cloudflare": { "type": "durable-object", "storage": "sqlite" },
    "Forms": { "type": "durable-object", "storage": "sqlite" },
  },
}
