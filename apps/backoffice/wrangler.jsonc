/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rejot-backoffice",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "preview_urls": true,
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./sandbox.Dockerfile",
      "instance_type": "lite",
      "max_instances": 4,
    },
  ],
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": { "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAACEAKTUMl498hZ6v",
    "AUTH_EMAIL_VERIFICATION_ENABLED": "false",
  },
  "routes": [
    {
      "pattern": "backoffice.rejot.dev",
      "custom_domain": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "UPLOAD_BUCKET",
      "bucket_name": "rejot-backoffice-upload",
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  /**
   * Outbound egress for codemode/workflow sandboxes. A self service binding to
   * the `OutboundProxy` entrypoint (see workers/app.ts) handed to dynamically
   * loaded Workers as their `globalOutbound`, so `fetch()` inside a workflow
   * step can reach the internet through the host worker.
   */
  "services": [
    {
      "binding": "OUTBOUND",
      "service": "rejot-backoffice",
      "entrypoint": "OutboundProxy",
    },
  ],
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
  /**
   * Durable Objects
   * https://developers.cloudflare.com/durable-objects/
   */
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "Api",
      },
      {
        "name": "AUTH",
        "class_name": "Auth",
      },
      {
        "name": "TELEGRAM",
        "class_name": "Telegram",
      },
      {
        "name": "RESEND",
        "class_name": "Resend",
      },
      {
        "name": "RESON8",
        "class_name": "Reson8",
      },
      {
        "name": "MCP",
        "class_name": "Mcp",
      },
      {
        "name": "OTP",
        "class_name": "Otp",
      },
      {
        "name": "UPLOAD",
        "class_name": "Upload",
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
      },
      {
        "name": "GITHUB",
        "class_name": "GitHub",
      },
      {
        "name": "GITHUB_WEBHOOK_ROUTER",
        "class_name": "GitHubWebhookRouter",
      },
      {
        "name": "AUTOMATIONS",
        "class_name": "Automations",
      },
      {
        "name": "BILLING",
        "class_name": "Billing",
      },
      {
        "name": "MARKETPLACE",
        "class_name": "Marketplace",
      },
      {
        "name": "CLOUDFLARE",
        "class_name": "Cloudflare",
      },
    ],
  },
  /**
   * Durable Object class lifecycle declarations
   * https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
   */
  "exports": {
    "Api": { "type": "durable-object", "storage": "sqlite" },
    "Auth": { "type": "durable-object", "storage": "sqlite" },
    "Telegram": { "type": "durable-object", "storage": "sqlite" },
    "Resend": { "type": "durable-object", "storage": "sqlite" },
    "Reson8": { "type": "durable-object", "storage": "sqlite" },
    "Mcp": { "type": "durable-object", "storage": "sqlite" },
    "Otp": { "type": "durable-object", "storage": "sqlite" },
    "Upload": { "type": "durable-object", "storage": "sqlite" },
    "Sandbox": { "type": "durable-object", "storage": "sqlite" },
    "GitHub": { "type": "durable-object", "storage": "sqlite" },
    "GitHubWebhookRouter": { "type": "durable-object", "storage": "sqlite" },
    "Automations": { "type": "durable-object", "storage": "sqlite" },
    "Billing": { "type": "durable-object", "storage": "sqlite" },
    "Marketplace": { "type": "durable-object", "storage": "sqlite" },
    "Cloudflare": { "type": "durable-object", "storage": "sqlite" },
  },
}
