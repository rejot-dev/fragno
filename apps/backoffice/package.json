{
  "name": "@fragno-apps/backoffice-rr",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "apps/backoffice"
  },
  "type": "module",
  "scripts": {
    "auth:migration:generate": "auth generate --config scripts/better-auth-cli.ts --output workers/auth/migrations/better-auth.sql --yes",
    "admin:grant": "bash scripts/grant-admin.sh",
    "build": "react-router build",
    "build:node": "BACKOFFICE_TARGET=node react-router build --config vite.node.config.ts && vite build --config vite.node-server.config.ts",
    "docker:prune:node": "rm -rf .docker-node && turbo prune @fragno-apps/backoffice-rr @fragno-private/backoffice-node-runtime --docker --out-dir=apps/backoffice/.docker-node && cp ../../.oxfmtrc.json .docker-node/.oxfmtrc.json",
    "docker:build:node": "pnpm run docker:prune:node && docker build --file Dockerfile.node --tag fragno-backoffice-node .docker-node",
    "docker:build:node:deployment": "pnpm run docker:prune:node && docker buildx build --platform linux/amd64 --file Dockerfile.node --tag \"${BACKOFFICE_IMAGE_TAG:?Set BACKOFFICE_IMAGE_TAG to the deployment image tag.}\" --load .docker-node",
    "start:node": "turbo run build:node --filter=@fragno-apps/backoffice-rr --output-logs=errors-only && NODE_ENV=development node scripts/node-server/start-node-processes.mjs",
    "start:node:server": "turbo run build:node --filter=@fragno-apps/backoffice-rr --output-logs=errors-only && NODE_ENV=development node --env-file-if-exists=.dev.vars --import ./build-node/node-opentelemetry-bootstrap.mjs ./build-node/node-server.mjs",
    "start:node:processor": "turbo run build:node --filter=@fragno-apps/backoffice-rr && NODE_ENV=development node --env-file-if-exists=.dev.vars --import ./build-node/node-opentelemetry-bootstrap.mjs ./build-node/node-hook-processor.mjs",
    "static:generate": "tsx scripts/generate-static-content.ts",
    "static:check": "tsx scripts/generate-static-content.ts --check",
    "static:fix": "tsx scripts/generate-static-content.ts --fix",
    "predeploy:bootstrap": "turbo run build --filter=@fragno-apps/backoffice-rr",
    "deploy:bootstrap": "node scripts/run-worker-release.mjs bootstrap",
    "predeploy:upload": "turbo run build --filter=@fragno-apps/backoffice-rr",
    "deploy:upload": "node scripts/run-worker-release.mjs upload",
    "deploy": "node scripts/run-worker-release.mjs deploy",
    "dev": "react-router dev",
    "preheap:profile": "turbo run build --filter=@fragno-apps/backoffice-rr --output-logs=errors-only",
    "heap:profile": "node scripts/profile-worker-heap.mjs",
    "preview": "node scripts/run-vite-preview.mjs",
    "preview:containers": "node scripts/run-vite-preview.mjs --containers",
    "types:check": "tsc -b --noEmit",
    "types:check:watch": "tsc -b --noEmit --watch",
    "types:generate": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv --env-file .dev.vars.example && react-router typegen",
    "test": "vitest run",
    "test:bridge": "vitest run --config vitest.bridge.config.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.1",
    "@base-ui/react": "^1.2.0",
    "@better-auth/oauth-provider": "^1.7.1",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/sandbox": "^0.12.4",
    "@earendil-works/chord": "1.0.0",
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-durable": "1.0.0",
    "@fragno-dev/api-fragment": "workspace:*",
    "@fragno-dev/cloudflare-fragment": "workspace:*",
    "@fragno-dev/codemode": "workspace:*",
    "@fragno-dev/core": "workspace:*",
    "@fragno-dev/db": "workspace:*",
    "@fragno-dev/forms": "workspace:*",
    "@fragno-dev/github-app-fragment": "workspace:*",
    "@fragno-dev/mcp-fragment": "workspace:*",
    "@fragno-dev/otp-fragment": "workspace:*",
    "@fragno-dev/project-connector-fragment": "workspace:*",
    "@fragno-dev/resend-fragment": "workspace:*",
    "@fragno-dev/reson8-fragment": "workspace:*",
    "@fragno-dev/tanstack-db-adapter": "workspace:*",
    "@fragno-dev/telegram-fragment": "workspace:*",
    "@fragno-dev/upload": "workspace:*",
    "@fragno-dev/workflow-visualizer-tokens": "workspace:*",
    "@fragno-dev/workflows": "workspace:*",
    "@fragno-private/design-system": "workspace:*",
    "@journeyapps/wa-sqlite": "^1.4.1",
    "@json-render/core": "0.20.0",
    "@json-render/react": "0.20.0",
    "@jsonforms/core": "^3.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@react-router/express": "8.2.0",
    "@tanstack/browser-db-sqlite-persistence": "0.2.14",
    "@tanstack/db-sqlite-persistence-core": "0.2.14",
    "@tanstack/react-db": "0.3.1",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.1",
    "better-sqlite3": "^12.10.0",
    "croner": "10.0.1",
    "express": "^5.2.1",
    "isbot": "^5.1.32",
    "isomorphic-git": "1.38.3",
    "jose": "^6.2.3",
    "js-tokens": "catalog:",
    "just-bash": "^3.0.1",
    "kysely": "^0.28.17",
    "nanostores": "^1.5.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.2.0",
    "resend": "^6.9.3",
    "streamdown": "^2.5.0",
    "typebox": "1.1.38",
    "yaml": "2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/shell": "^0.4.3",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@fragno-apps/cf-sandbox-bridge": "workspace:*",
    "@fragno-dev/test": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "ajv": "^8.18.0",
    "auth": "^1.7.1",
    "happy-dom": "^20.3.3",
    "oxfmt": "^0.40.0",
    "tailwindcss": "^4.1.18",
    "typescript": "catalog:",
    "undici": "^8.3.0",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
