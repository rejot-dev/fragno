# Public, build-time PostHog configuration for the deployed Cloudflare frontend only.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
VITE_POSTHOG_APP_ORIGIN=https://leyway.com

# Workers AI has no local simulator, so the dev server connects to, and bills, the account Wrangler
# is logged in to. Uncomment to keep it local; Workers AI is then unavailable. The Cloudflare Vite
# plugin reads this from .env, and it turns off every remote binding.
# CLOUDFLARE_VITE_FORCE_LOCAL=true
