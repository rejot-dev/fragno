{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "composite": true,
    "noEmit": true,
    "noResolve": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["**/*.js", "static/codemode/**/*.d.ts"],
  // Published versions are immutable. These use removed tools, such as telegram.* and Pi sessions, and
  // are kept only as release history; later versions replace them.
  "exclude": [
    "marketplace/telegram-channel/versions/1.0.0/**",
    "marketplace/telegram-channel/versions/1.0.1/**",
    "marketplace/telegram-channel/versions/1.1.0/**",
    "marketplace/telegram-test-command/versions/1.0.0/**",
    "marketplace/telegram-test-command/versions/1.1.0/**",
    "marketplace/telegram-test-command/versions/1.2.1/**",
    "marketplace/telegram-test-command/versions/1.3.0/**"
  ]
}
