        "payload": {
          "kind": "projection",
          "fields": {
            "deliveryId": "$.payload.deliveryId",
            "installationId": "$.payload.installationId",
            "repository": "$.payload.repository",
            "issue": "$.payload.issue",
            "comment": "$.payload.raw.comment",
            "sender": "$.payload.sender"
          }
        }
      }
    },
