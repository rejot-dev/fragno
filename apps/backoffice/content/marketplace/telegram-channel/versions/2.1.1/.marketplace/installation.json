{
  "permissions": [
    {
      "namespace": "identity",
      "permission": "resolve"
    },
    {
      "namespace": "integrations",
      "permission": "execute"
    },
    {
      "namespace": "otp",
      "permission": "create"
    },
    {
      "namespace": "store",
      "permission": "modify"
    }
  ],
  "routes": [
    {
      "id": "telegram-start-linking",
      "name": "Telegram /start identity linking",
      "trigger": {
        "kind": "event",
        "source": "telegram",
        "eventType": "message.received",
        "matcher": {
          "path": "$.payload.text",
          "op": "eq",
          "value": "/start"
        }
      },
      "priority": 100,
      "action": {
        "kind": "start_workflow",
        "authority": {
          "kind": "organization-automation",
          "grants": [
            {
              "namespace": "identity",
              "permission": "resolve"
            },
            {
              "namespace": "integrations",
              "permission": "execute"
            },
            {
              "namespace": "otp",
              "permission": "create"
            },
            {
              "namespace": "store",
              "permission": "modify"
            }
          ]
        },
        "workflowScriptPath": "automations/telegram-user-linking.workflow.js",
        "instanceIdTemplate": "telegram-link-${event.id}"
      }
    },
    {
      "id": "telegram-identity-claim-completed",
      "name": "Forward Telegram identity claim completion",
      "trigger": {
        "kind": "event",
        "source": "otp",
        "eventType": "identity.claim.completed",
        "matcher": {
          "actor": {
            "participation": "initiator",
            "scope": "external",
            "source": "telegram"
          }
        }
      },
      "priority": 90,
      "action": {
        "kind": "send_workflow_event",
        "target": {
          "kind": "stored_instance_id",
          "keyTemplate": "telegram/claim-workflow/${event.payload.otpId}"
        },
        "eventType": "identity-claim-completed",
        "payload": "$event"
      }
    },
    {
      "id": "telegram-pi-linking",
      "name": "Telegram Pi agent messages",
      "trigger": {
        "kind": "event",
        "source": "telegram",
        "eventType": "message.received",
        "matcher": {
          "any": [
            {
              "path": "$.payload.text",
              "op": "eq",
              "value": "/pi"
            },
            {
              "all": [
                {
                  "path": "$.payload.text",
                  "op": "exists"
                },
                {
                  "not": {
                    "path": "$.payload.text",
                    "op": "startsWith",
                    "value": "/"
                  }
                }
              ]
            }
          ]
        }
      },
      "priority": 120,
      "action": {
        "kind": "start_workflow",
        "authority": {
          "kind": "linked-user",
          "grants": "inherit"
        },
        "workflowScriptPath": "automations/telegram-user-pi-linking.workflow.js",
        "instanceIdTemplate": "telegram-pi-${event.id}"
      }
    },
    {
      "id": "telegram-pi-turn-completed",
      "name": "Resume Telegram Pi workflow on turn.completed",
      "trigger": {
        "kind": "event",
        "source": "pi",
        "eventType": "turn.completed",
        "matcher": {
          "all": [
            {
              "path": "$.subject.agentName",
              "op": "eq",
              "value": "telegram"
            },
            {
              "path": "$.subject.requestId",
              "op": "startsWith",
              "value": "telegram-pi-"
            }
          ]
        }
      },
      "priority": 100,
      "action": {
        "kind": "send_workflow_event",
        "target": {
          "kind": "instance_id",
          "template": "${event.subject.requestId}"
        },
        "eventType": "pi-turn-settled"
      }
    },
    {
      "id": "telegram-pi-turn-failed",
      "name": "Resume Telegram Pi workflow on turn.failed",
      "trigger": {
        "kind": "event",
        "source": "pi",
        "eventType": "turn.failed",
        "matcher": {
          "all": [
            {
              "path": "$.subject.agentName",
              "op": "eq",
              "value": "telegram"
            },
            {
              "path": "$.subject.requestId",
              "op": "startsWith",
              "value": "telegram-pi-"
            }
          ]
        }
      },
      "priority": 100,
      "action": {
        "kind": "send_workflow_event",
        "target": {
          "kind": "instance_id",
          "template": "${event.subject.requestId}"
        },
        "eventType": "pi-turn-settled"
      }
    },
    {
      "id": "telegram-pi-turn-aborted",
      "name": "Resume Telegram Pi workflow on turn.aborted",
      "trigger": {
        "kind": "event",
        "source": "pi",
        "eventType": "turn.aborted",
        "matcher": {
          "all": [
            {
              "path": "$.subject.agentName",
              "op": "eq",
              "value": "telegram"
            },
            {
              "path": "$.subject.requestId",
              "op": "startsWith",
              "value": "telegram-pi-"
            }
          ]
        }
      },
      "priority": 100,
      "action": {
        "kind": "send_workflow_event",
        "target": {
          "kind": "instance_id",
          "template": "${event.subject.requestId}"
        },
        "eventType": "pi-turn-settled"
      }
    },
    {
      "id": "telegram-pi-queue-dropped",
      "name": "Resume Telegram Pi workflow on queue.dropped",
      "trigger": {
        "kind": "event",
        "source": "pi",
        "eventType": "queue.dropped",
        "matcher": {
          "all": [
            {
              "path": "$.subject.agentName",
              "op": "eq",
              "value": "telegram"
            },
            {
              "path": "$.subject.requestId",
              "op": "startsWith",
              "value": "telegram-pi-"
            }
          ]
        }
      },
      "priority": 100,
      "action": {
        "kind": "send_workflow_event",
        "target": {
          "kind": "instance_id",
          "template": "${event.subject.requestId}"
        },
        "eventType": "pi-turn-settled"
      }
    }
  ],
  "agents": [
    {
      "agentName": "telegram",
      "description": "Answers messages from Telegram chats linked to Backoffice users.",
      "model": null,
      "permissions": ["*"],
      "instructions": "Messages arrive from Telegram chats linked to Backoffice users. Each one starts with the chat\nit came from, such as `[Telegram chat 1001]`, and runs with the permissions of that chat's\nlinked user.\n\nIMPORTANT: your final answer to each message is AUTOMATICALLY sent back to its chat in Telegram\nMarkdown parse mode. Keep it short, and do not repeat the chat prefix."
    }
  ]
}
