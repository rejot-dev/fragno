# Canonical env template for local docs development.
# This file is also used by `pnpm run types:generate` to keep worker types deterministic.

# Optional Node runtime override; defaults to this git-ignored directory.
BACKOFFICE_SQLITE_DIR=./.backoffice-node

# Node codemode, TypeScript checking, and sandbox management use one cf-sandbox-bridge deployment.
# Use the HTTPS origin; codemode derives WSS for WebSocket activations.
# The key must match SANDBOX_API_KEY on that bridge; no local fallback is used.
CLOUDFLARE_BRIDGE_URL=https://cf-sandbox-bridge.rejot.workers.dev/
CLOUDFLARE_BRIDGE_API_KEY=

# Node OpenTelemetry starts only when this collector endpoint is configured. The common OTLP
# endpoint is expanded to /v1/traces and /v1/metrics by the HTTP/protobuf exporters.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1

# Node claims both 127.0.0.1 and ::1 by default so localhost cannot reach another process.
# Set HOST explicitly only when the proxy runs elsewhere. Trust only the proxy's IP/CIDR for
# X-Forwarded-Proto; false disables proxy trust.
BACKOFFICE_TRUST_PROXY=loopback

# For GitHub OAuth (login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# For auth access-token cookies. Set a strong secret in production.
AUTH_ACCESS_TOKEN_SECRET=dev-auth-access-token-secret-replace-me

# Signs trusted execution context sent between the web Worker and Durable Objects.
# Configure the same value on both deployments.
BACKOFFICE_INTERNAL_REQUEST_SECRET=dev-backoffice-internal-request-secret-replace-me

# Allows POST /api/admin/grant to promote an existing account.
# The first administrator may be unverified; every subsequent administrator must be verified.
# Required on the object host; leave unset only to disable granting during local development.
AUTH_ADMIN_GRANT_TOKEN=

# Require Auth email verification and deliver challenges through the singleton Resend connection.
# DOCS_PUBLIC_BASE_URL must be an absolute HTTP(S) URL when this is true.
AUTH_EMAIL_VERIFICATION_ENABLED=false

# Require an email-bound system administrator invitation before creating an account.
SIGN_UP_INVITATIONS_ENABLED=false

# Canonical public URL for links and proxy access. Use 127.0.0.1 for local Node development;
# localhost remains an alias available only from loopback without proxy forwarding headers.
DOCS_PUBLIC_BASE_URL=http://127.0.0.1:5173/

# Pi model providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# For the singleton Cloudflare fragment and Browser Run Quick Actions
CLOUDFLARE_WORKERS_ACCOUNT_ID=example-account-id
CLOUDFLARE_WORKERS_API_TOKEN=example-api-token

# For GitHub App
GITHUB_APP_ID=1234567
GITHUB_APP_SLUG=local-example-app
GITHUB_APP_CLIENT_ID=Iv23exampleclientid
GITHUB_APP_CLIENT_SECRET=example_client_secret_replace_me
GITHUB_APP_WEBHOOK_SECRET=example_webhook_secret_replace_me
GITHUB_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nEXAMPLE_PRIVATE_KEY_CONTENT_REPLACE_ME\n-----END PRIVATE KEY-----\n
