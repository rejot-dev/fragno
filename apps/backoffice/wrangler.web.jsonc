{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rejot-backoffice-web",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough",
    // Compiles each module on first import instead of at startup, to shorten cold starts.
    "new_module_registry",
  ],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    // Feeds the "new Worker issue" alert in apps/infra.
    "issues": {
      "enabled": true,
    },
  },
  "preview_urls": true,
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAACEAKTUMl498hZ6v",
    "AUTH_EMAIL_VERIFICATION_ENABLED": "true",
    "SIGN_UP_ACCESS_CODES_REQUIRED": "true",
    // Keeps each organization's and user's Durable Objects in the jurisdiction they chose. Only
    // local .dev.vars says "local", as workerd does not implement jurisdictions.
    "DURABLE_OBJECT_JURISDICTIONS": "enforced",
    "SITES_ENABLED": "true",
    // Local servers started without the bridge's containers say "false", so sandbox starts fail at once.
    "SANDBOX_CONTAINERS": "true",
    "DOCS_PUBLIC_BASE_URL": "https://leyway.com/",
    // People's inbound addresses; its MX records point at the platform Resend account.
    "INBOUND_EMAIL_DOMAIN": "ley.run",
    "SITES_DOMAIN": "ley.run",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    // Site builds are kept in the blobs buckets, which this Worker reads site files from.
    "BLOBS_R2_BUCKET": "rejot-backoffice-blobs",
  },
  "secrets": {
    "required": [
      "BACKOFFICE_INTERNAL_REQUEST_SECRET",
      "RESON8_API_KEY",
      "BLOBS_R2_ENDPOINT",
      "BLOBS_R2_ACCESS_KEY_ID",
      "BLOBS_R2_SECRET_ACCESS_KEY",
    ],
  },
  "routes": [
    {
      "pattern": "leyway.com",
      "custom_domain": true,
    },
    // The former domain keeps serving: webhook URLs already handed to providers point at it.
    {
      "pattern": "backoffice.rejot.dev",
      "custom_domain": true,
    },
    // Each scope's sites, at SITES_DOMAIN's subdomains. Custom domains cannot be wildcards, so a
    // route serves them, behind the zone's proxied wildcard DNS record.
    {
      "pattern": "*.ley.run/*",
      "zone_name": "ley.run",
    },
  ],
  // Tags telemetry with the deployed version, so errors and metrics can be compared per release.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Codemode guests compile and run in the bridge, one request each. This Worker loads only site
  // Workers, per request, outside any Durable Object and its cap on concurrent Dynamic Workers.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Counts the events each viewer of a site fires, per site, as SITE_EVENT_LIMITS describes. Both
  // Workers fire site events and share the namespace, so they share the count.
  "ratelimits": [
    { "name": "SITE_EVENTS", "namespace_id": "1001", "simple": { "limit": 60, "period": 10 } },
  ],
  "services": [
    {
      "binding": "CODEMODE_COMPILER",
      "service": "cf-sandbox-bridge",
      "entrypoint": "CodemodeCompiler",
    },
    {
      "binding": "CODEMODE_EXECUTOR",
      "service": "cf-sandbox-bridge",
      "entrypoint": "CodemodeExecutor",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "Api",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "AUTH",
        "class_name": "Auth",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "TELEGRAM",
        "class_name": "Telegram",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "RESEND",
        "class_name": "Resend",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "MCP",
        "class_name": "Mcp",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "PROJECT_CONNECTOR",
        "class_name": "ProjectConnectorDurableObject",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "OTP",
        "class_name": "Otp",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "UPLOAD",
        "class_name": "Upload",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "BLOBS",
        "class_name": "Blobs",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
        "script_name": "cf-sandbox-bridge",
      },
      {
        "name": "SANDBOX_MANAGER",
        "class_name": "SandboxManager",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "GITHUB",
        "class_name": "GitHub",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "GITHUB_WEBHOOK_ROUTER",
        "class_name": "GitHubWebhookRouter",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "AUTOMATIONS",
        "class_name": "Automations",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "PI",
        "class_name": "Pi",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "PI_MANAGER",
        "class_name": "PiManager",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "BILLING",
        "class_name": "Billing",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "CODEMODE",
        "class_name": "Codemode",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "MARKETPLACE",
        "class_name": "Marketplace",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "APPS",
        "class_name": "Apps",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "APP_INSTALLATIONS",
        "class_name": "AppInstallations",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "CLOUDFLARE",
        "class_name": "Cloudflare",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "PRESENCE",
        "class_name": "Presence",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "SITE_REPLICA",
        "class_name": "SiteReplica",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "SITE_REQUESTS",
        "class_name": "SiteRequests",
        "script_name": "rejot-backoffice",
      },
    ],
  },
}
