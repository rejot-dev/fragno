{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rejot-backoffice-web",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "enable_request_signal",
    "request_signal_passthrough",
  ],
  "main": "./workers/app.ts",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "preview_urls": true,
  "vars": {
    "TURNSTILE_SITEKEY": "0x4AAAAAACEAKTUMl498hZ6v",
    "AUTH_EMAIL_VERIFICATION_ENABLED": "true",
    "SIGN_UP_INVITATIONS_ENABLED": "true",
    "DOCS_PUBLIC_BASE_URL": "https://backoffice.rejot.dev/",
  },
  "secrets": {
    "required": ["BACKOFFICE_INTERNAL_REQUEST_SECRET"],
  },
  "routes": [
    {
      "pattern": "backoffice.rejot.dev",
      "custom_domain": true,
    },
  ],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "services": [
    {
      "binding": "OUTBOUND",
      "service": "rejot-backoffice",
      "entrypoint": "OutboundProxy",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API",
        "class_name": "Api",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "AUTH",
        "class_name": "Auth",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "TELEGRAM",
        "class_name": "Telegram",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "RESEND",
        "class_name": "Resend",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "RESON8",
        "class_name": "Reson8",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "MCP",
        "class_name": "Mcp",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "OTP",
        "class_name": "Otp",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "UPLOAD",
        "class_name": "Upload",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "SANDBOX",
        "class_name": "Sandbox",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "GITHUB",
        "class_name": "GitHub",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "GITHUB_WEBHOOK_ROUTER",
        "class_name": "GitHubWebhookRouter",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "AUTOMATIONS",
        "class_name": "Automations",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "BILLING",
        "class_name": "Billing",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "MARKETPLACE",
        "class_name": "Marketplace",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "CLOUDFLARE",
        "class_name": "Cloudflare",
        "script_name": "rejot-backoffice",
      },
      {
        "name": "FORMS",
        "class_name": "Forms",
        "script_name": "rejot-backoffice",
      },
    ],
  },
}
