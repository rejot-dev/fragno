{
  "name": "@fragno-dev/tanstack-db-adapter",
  "version": "0.0.1",
  "description": "Ingest Fragno database outboxes into TanStack DB collections",
  "homepage": "https://fragno.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "packages/tanstack-db-adapter"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/coordinator.js",
  "module": "./dist/coordinator.js",
  "types": "./dist/coordinator.d.ts",
  "exports": {
    ".": {
      "types": "./dist/coordinator.d.ts",
      "default": "./dist/coordinator.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@fragno-dev/db": "workspace:*",
    "@tanstack/db-sqlite-persistence-core": "0.2.14",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@fragno-dev/core": "workspace:*",
    "@fragno-dev/test": "workspace:*",
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@journeyapps/wa-sqlite": "^1.4.1",
    "@tanstack/browser-db-sqlite-persistence": "^0.2.14",
    "@tanstack/db": "^0.8.1",
    "@tanstack/node-db-sqlite-persistence": "^0.2.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "@vitest/coverage-istanbul": "^4.1.0",
    "better-sqlite3": "^12.6.2",
    "tsdown": "^0.22.4",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@fragno-dev/core": "^0.2.3",
    "@fragno-dev/test": "^2.0.3",
    "@journeyapps/wa-sqlite": "^1.4.1",
    "@tanstack/browser-db-sqlite-persistence": "^0.2.14",
    "@tanstack/db": "^0.8.1",
    "@tanstack/node-db-sqlite-persistence": "^0.2.14",
    "better-sqlite3": "^12.6.2"
  },
  "peerDependenciesMeta": {
    "@fragno-dev/core": {
      "optional": true
    },
    "@fragno-dev/test": {
      "optional": true
    },
    "@journeyapps/wa-sqlite": {
      "optional": true
    },
    "@tanstack/browser-db-sqlite-persistence": {
      "optional": true
    },
    "@tanstack/node-db-sqlite-persistence": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  }
}
