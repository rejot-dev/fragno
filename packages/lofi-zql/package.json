{
  "name": "@fragno-dev/lofi-zql",
  "version": "0.0.1",
  "description": "Live ZQL views of a Fragno lofi SQLite replica, maintained incrementally",
  "homepage": "https://fragno.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "packages/lofi-zql"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/mod.js",
  "module": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@badrap/valita": "0.5.5",
    "@databases/escape-identifier": "^1.0.3",
    "@databases/sql": "^3.3.0",
    "@fragno-dev/db": "workspace:*",
    "@fragno-dev/lofi": "workspace:*",
    "@rocicorp/logger": "^6.2.0",
    "compare-utf8": "^0.2.3"
  },
  "devDependencies": {
    "@fragno-dev/core": "workspace:*",
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@journeyapps/wa-sqlite": "^2.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "@vitest/coverage-istanbul": "^4.1.0",
    "better-sqlite3": "^12.6.2",
    "kysely": "^0.28.10",
    "tsdown": "^0.22.4",
    "vitest": "catalog:"
  }
}
