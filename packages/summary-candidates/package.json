{
  "name": "@fragno-dev/summary-candidates",
  "version": "0.0.0",
  "description": "Generate diverse extractive summary candidates for external scoring.",
  "homepage": "https://fragno.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rejot-dev/fragno.git",
    "directory": "packages/summary-candidates"
  },
  "bin": {
    "summary-candidates": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "samples",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/generate-summary-candidates.d.ts",
      "default": "./dist/generate-summary-candidates.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "format:package": "node ../../scripts/run-package-quality.mjs format",
    "format:check:package": "node ../../scripts/run-package-quality.mjs format:check",
    "lint:package": "node ../../scripts/run-package-quality.mjs lint",
    "lint:fix:package": "node ../../scripts/run-package-quality.mjs lint:fix"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@fragno-private/typescript-config": "workspace:*",
    "@fragno-private/vitest-config": "workspace:*",
    "@types/node": "^22.19.7",
    "tsdown": "^0.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
